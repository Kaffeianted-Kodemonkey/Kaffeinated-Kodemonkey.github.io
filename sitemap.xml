---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.pages | sort: 'url' %}
  {% for page in pages %}
    {% if page.layout and page.sitemap != false and page.noindex != true and page.redirect_to == nil and page.url != '/404.html' and page.url != '/sitemap.xml' and page.url != '/monkeyhub/support_ticket/' and page.url != '/robots.txt' and page.url contains '/' %}
      {% unless page.url contains '/REMOVE/' or page.url contains '/assets/' or page.url == '/Book_Consultation' %}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
    {% assign page_modified = page.last_modified_at | default: page.date %}
    {% if page_modified %}<lastmod>{{ page_modified | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
      {% endunless %}
    {% endif %}
  {% endfor %}
  {% assign posts = site.posts | sort: 'url' %}
  {% for post in posts %}
  {% if post.sitemap != false and post.noindex != true and post.redirect_to == nil %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    {% assign post_modified = post.last_modified_at | default: post.date %}
    {% if post_modified %}<lastmod>{{ post_modified | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {% endif %}
  {% endfor %}
</urlset>
