---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign pages = site.pages | sort: 'url' %}
  {% for page in pages %}
    {% unless page.url == '/404.html' or page.url == '/sitemap.xml' or page.url == '/monkeyhub/support_ticket/' or page.url contains '/REMOVE/' %}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
  </url>
    {% endunless %}
  {% endfor %}
  {% assign posts = site.posts | sort: 'url' %}
  {% for post in posts %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
  </url>
  {% endfor %}
</urlset>
